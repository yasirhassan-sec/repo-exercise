# --- Required in production ---
# Secret for signing session cookies (HMAC-SHA256). At least 32 random characters.
#   Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# SMS gateway for one-time codes. The app POSTs JSON {"to": "...", "message": "..."}.
MILKIYAT_SMS_WEBHOOK_URL=
MILKIYAT_SMS_WEBHOOK_TOKEN=

# --- Branding / contact (shown on every page) ---
MILKIYAT_ORG_NAME=[Department name]
MILKIYAT_ORG_NAME_UR=[محکمے کا نام]
MILKIYAT_HELPLINE=[Helpline number]
MILKIYAT_OFFICE_HOURS=[Office hours]

# --- Deployment ---
# Folder for users.json and the audit log. Keep it outside the web root and back it up.
MILKIYAT_DATA_DIR=./data
# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
MILKIYAT_TRUST_PROXY=false

# Demo mode: seeds test accounts and shows one-time codes on screen. NEVER enable in production.
MILKIYAT_DEMO_MODE=false
